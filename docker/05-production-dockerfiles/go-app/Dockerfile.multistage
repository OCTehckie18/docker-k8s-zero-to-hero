# ---- Stage 1: build -------------------------------------------------------
FROM golang:1.23 AS build
WORKDIR /src
# Copy dependency manifests first so `go mod download` is cached
# until go.mod/go.sum actually change.
COPY go.mod ./
RUN go mod download
COPY . .
# Static binary: no libc needed at runtime.
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /server .

# ---- Stage 2: run ---------------------------------------------------------
# distroless/static: no shell, no package manager, runs as non-root.
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /server /server
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/server"]
